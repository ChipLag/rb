function collect()
  local team = getTeam()
  local giver = team.Essentials.Giver
  
  firetouchinterest(giver, Player.Character.HumanoidRootPart, 0)

  firetouchinterest(giver, Player.Character.HumanoidRootPart, 1)
end

function upgrade()
  local team = getTeam()
  for _, v in pairs(team:FindFirstChild("Buttons"):GetChildren()) do
    if v.Head.Transparency == 1 then continue end
    log(v.Name .. v.Price.Value)
    if v.Price.Value <= parseCash() then
      log("ok")
      touch(v.Head)
    end
  end
end


function getPartCollector()
  for i,v in pairs(getTeam().Essentials:GetChildren()) do
    if v.Name == "PartCollector" and v.Transparency == 0 then return v end -- At least one will return
  end
end

function parseCash()
  local cashString = tostring(Player.leaderstats.Cash.Value)
  return parseShorthand(cashString)
end

function parseShorthand(str)
  str = str:gsub("%+", ""):gsub(",", ""):gsub("%s", "") -- remove +, commas, spaces
  local num, suffix = str:match("^([%d%.]+)([KkMmBbTt]?)$")
  if not num then return tonumber(str) or 0 end
  num = tonumber(num)
  suffix = suffix:upper()
  local multipliers = {
    K = 1e3,
    M = 1e6,
    B = 1e9,
    T = 1e12,
  }
  return math.floor(num * (multipliers[suffix] or 1))
end

function stealParts()
  for i,v in pairs(game.Workspace.PartStorage:GetChildren()) do
   v.CFrame = getPartCollector().CFrame
   firetouchinterest(getPartCollector(), v, false)
   firetouchinterest(getPartCollector(), v, true)
  end
end


