local Player = game:GetService("Players").LocalPlayer

function getTeam()
  local plrTeam = Player.TeamColor
  for i,v in pairs(game:GetService("Workspace"):FindFirstChild("Tycoons"):FindFirstChild("Tycoons"):GetChildren()) do
    if not v:FindFirstChild("TeamColor") then continue end
    if v:FindFirstChild("TeamColor").Value == plrTeam then
      --log("Team: " .. v.Name)
      return v
    end
  end
end

